# SECRETOS JWT (necesarios para autenticacion)
JWT_SECRET_KEY=pon_aqui_un_secreto_largo_aleatorio
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# SMTP - envio de emails (solo si tu app envia correos)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=tu_correo@gmail.com
SENDER_PASSWORD=tu_app_password_de_gmail

# Base de datos
#  - Modo nativo (uvicorn): usa estos valores directamente
#  - Docker: IGNORADAS en el contenedor (compose usa mongodb://mongo:27017 y galery)
MONGO_URL=mongodb://localhost:27017
DB_NAME=galery_dom
